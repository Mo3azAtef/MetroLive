# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/metro?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Seed admin account
SEED_ADMIN_EMAIL=admin@metro.com
SEED_ADMIN_PASSWORD=Admin123!
