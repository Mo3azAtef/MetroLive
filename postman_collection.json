{
  "info": {
    "name": "Metro Live System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "stationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@metro.com\",\n  \"password\": \"Admin123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Stations",
      "item": [
        {
          "name": "GET /stations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.length) {",
                  "    pm.collectionVariables.set('stationId', json.data[0]._id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/stations"
          }
        }
      ]
    },
    {
      "name": "Announcements",
      "item": [
        {
          "name": "GET /stations/:stationId/announcements",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements?page=1&limit=20"
          }
        },
        {
          "name": "GET /stations/:stationId/announcements?severity=delay",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements?severity=delay"
          }
        },
        {
          "name": "POST /stations/:stationId/announcements (no token -> 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Next train arriving in 3 minutes\",\n  \"severity\": \"info\"\n}"
            }
          }
        },
        {
          "name": "POST /stations/:stationId/announcements (with token -> 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Next train arriving in 3 minutes\",\n  \"severity\": \"info\"\n}"
            }
          }
        }
      ]
    }
  ]
}
